# ===================================================================
# AI-Powered Virtual Pet Application - Environment Configuration
# ===================================================================

# Django Secret Key (Provide a secure string for production)
SECRET_KEY=django-insecure-ai-virtual-pet-secret-key-change-in-production

# Debug Mode (True for local development and exams, False for production)
DEBUG=True

# Optional: Google Gemini API Key
# If you have an API key, paste it here.
# If left blank, the application automatically uses the built-in Intelligent Fallback Response System!
GEMINI_API_KEY=

# Optional: AI Model choice (e.g., gemini-1.5-flash, gemini-2.5-flash)
GEMINI_MODEL=gemini-1.5-flash
